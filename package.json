{
  "name": "interlude-cinema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "ui": "vite --host 127.0.0.1",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "infra": "docker compose up -d redis livekit",
    "test:media": "node scripts/media-fixtures.mjs",
    "format": "prettier --write src tests/e2e tests/experience.test.ts scripts/licenses.mjs extensions/watch-sync shared/website.ts tests/website.test.ts",
    "format:check": "prettier --check src tests/e2e tests/experience.test.ts scripts/licenses.mjs extensions/watch-sync shared/website.ts tests/website.test.ts",
    "media:local": "node scripts/media-local.mjs"
  },
  "dependencies": {
    "@livekit/protocol": "1.52.1",
    "@mantine/core": "8.3.10",
    "@mantine/hooks": "8.3.10",
    "@mediabunny/ac3": "1.61.3",
    "@tabler/icons-react": "3.35.0",
    "cookie": "1.0.2",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "livekit-client": "2.22.4",
    "livekit-server-sdk": "2.19.1",
    "mediabunny": "1.61.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "path-to-regexp": "8.4.2",
    "body-parser": "2.3.0",
    "qs": "6.16.1",
    "engine.io": "6.6.11",
    "engine.io-client": "6.6.7",
    "socket.io-parser": "4.2.7",
    "ws": "8.22.0",
    "socket.io-adapter": "2.5.8"
  }
}
