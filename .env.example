# Run node scripts/setup-dev.mjs for random local credentials.
HOST=127.0.0.1
PORT=18080
APP_ORIGIN=http://127.0.0.1:15173
SESSION_SECRET=replace-with-at-least-32-random-characters
REDIS_URL=redis://127.0.0.1:6379
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=replace-with-your-key
LIVEKIT_API_SECRET=replace-with-random-secret
# PUBLIC_ORIGIN=http://localhost:18080 is used by the Compose app.
# Production requires NODE_ENV=production, HTTPS and WSS URLs.
